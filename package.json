{
  "name": "nwutils",
  "private": true,
  "description": "Monorepo for nw-builder and the NW.js tooling packages it depends on.",
  "license": "MIT",
  "homepage": "https://github.com/nwutils/nw-builder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nwutils/nw-builder.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "type": "npm run type --workspaces --if-present",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.13.0",
      "onFail": "warn"
    }
  },
  "volta": {
    "node": "26.7.0",
    "npm": "11.13.0"
  },
  "prettier": {
    "endOfLine": "lf"
  }
}
