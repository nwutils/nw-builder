{
  "name": "nwutils",
  "private": true,
  "description": "Monorepo for nw-builder and the NW.js tooling packages it depends on.",
  "license": "MIT",
  "homepage": "https://github.com/nwutils/nw-builder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nwutils/nw-builder.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "type": "npm run type --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nwutils/getter": "^0.2.6",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/nw.js": "^0.115.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@types/semver": "^7.8.0",
    "@types/yauzl-promise": "^4.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "nw": "^0.118.0",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.51.0",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "warn"
    }
  },
  "prettier": {
    "endOfLine": "lf"
  }
}
