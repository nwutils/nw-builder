{
  "name": "@nwutils/cli",
  "version": "0.1.4",
  "description": "Command line interface for building NW.js applications",
  "keywords": [
    "NW.js",
    "node-webkit",
    "Desktop",
    "Application"
  ],
  "author": {
    "name": "Ayushman Chhabra",
    "url": "https://ayushmanchhabra.com"
  },
  "maintainers": [
    {
      "name": "Ayushman Chhabra",
      "url": "https://ayushmanchhabra.com"
    }
  ],
  "contributors": [
    {
      "name": "@nwutils/cli Contributors",
      "url": "https://github.com/nwutils/nw-builder/graphs/contributors"
    }
  ],
  "license": "MIT",
  "main": "./src/index.js",
  "bin": {
    "nw-cli": "src/cli.js"
  },
  "types": "types/index.d.ts",
  "type": "module",
  "files": [
    "LICENSE",
    "src",
    "types"
  ],
  "homepage": "https://github.com/nwutils/nw-builder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nwutils/nw-builder.git",
    "directory": "./packages/cli"
  },
  "scripts": {
    "lint": "eslint ./src ../../tests/specs/cli",
    "type": "tsc",
    "test": "node --test \"../../tests/specs/cli/*.test.js\""
  },
  "dependencies": {
    "@nwutils/getter": "^0.2.4",
    "@nwutils/runner": "^0.2.7",
    "commander": "^15.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "warn"
    }
  }
}
