From: Ayushman Chhabra <14110965+ayushmanchhabra@users.noreply.github.com>
Date: Sun, 22 Nov 2026 06:12:47 +0000
Subject: [PATCH] Fix crash when picking a folder with nwdirectory

nwdirectory picks the folder itself, so base_dir is empty and
RemoveSymlinks() CHECKs it.

Refs: nwjs/nw.js#8393
---
 content/browser/web_contents/file_chooser_impl.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/content/browser/web_contents/file_chooser_impl.cc b/content/browser/web_contents/file_chooser_impl.cc
index d0e46983..1b593f04 100644
--- a/content/browser/web_contents/file_chooser_impl.cc
+++ b/content/browser/web_contents/file_chooser_impl.cc
@@ -102,7 +102,8 @@ void FileChooserImpl::FileSelectListenerImpl::FileSelected(
   if (!owner_)
     return;
 
-  if (mode != blink::mojom::FileChooserParams::Mode::kUploadFolder) {
+  if (mode != blink::mojom::FileChooserParams::Mode::kUploadFolder ||
+      base_dir.empty()) {
     owner_->FileSelected(base_dir, mode, std::move(files));
     return;
   }
