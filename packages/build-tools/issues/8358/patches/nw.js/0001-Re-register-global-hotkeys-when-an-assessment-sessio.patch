From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ayushman Chhabra <14110965+ayushmanchhabra@users.noreply.github.com>
Date: Sun, 22 Nov 2026 19:39:42 +0000
Subject: [PATCH] Re-register global hotkeys when an assessment session begins

Starting the session drops their Carbon registrations, so they stopped
firing in kiosk mode.

Refs: nwjs/nw.js#8358
---
 src/nw_content_mac.mm | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/nw_content_mac.mm b/src/nw_content_mac.mm
index cf91688..f76c958 100644
--- a/src/nw_content_mac.mm
+++ b/src/nw_content_mac.mm
@@ -5,6 +5,7 @@
 
 #include "content/nw/src/api/menu/menu.h"
 #include "content/nw/src/api/menuitem/menuitem.h"
+#include "content/nw/src/api/shortcut/global_shortcut_listener.h"
 #include "extensions/browser/app_window/native_app_window.h"
 #import  "ui/gfx/mac/nswindow_frame_controls.h"
 #include "chrome/grit/generated_resources.h"
@@ -65,6 +66,13 @@ API_AVAILABLE(macos(10.15.4))
 
 - (void)assessmentSessionDidBegin:(AEAssessmentSession *)assessmentSession {
     NSLog(@"ASSESSMENT MODE ENABLED");
+    dispatch_async(dispatch_get_main_queue(), ^{
+      auto* listener = nwapi::GlobalShortcutListener::GetInstance();
+      if (!listener->IsShortcutHandlingSuspended()) {
+        listener->SetShortcutHandlingSuspended(true);
+        listener->SetShortcutHandlingSuspended(false);
+      }
+    });
 }
 
 - (void)assessmentSessionDidEnd:(AEAssessmentSession *)assessmentSession {
