From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ayushman Chhabra <14110965+ayushmanchhabra@users.noreply.github.com>
Date: Sun, 22 Nov 2026 06:13:15 +0000
Subject: [PATCH 2/2] Link node_js2c with Chromium's libc++ on Linux

It's built with Chromium's libc++ headers but only linked with -lstdc++.
---
 node.gyp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/node.gyp b/node.gyp
index 00c1905..0daba6f 100644
--- a/node.gyp
+++ b/node.gyp
@@ -2124,6 +2124,9 @@
           'defines': ['NODE_JS2C_USE_STRING_LITERALS'],
 	  'ldflags': [ '-lstdc++' ], #'-Wl,--whole-archive <(LIBSIMDUTF)', '-Wl,--no-whole-archive' ],
         }],
+        [ 'OS=="linux" and building_nw==1', {
+          'libraries': [ '<(LIBCXX)' ],
+        }],
         [ 'debug_node=="true"', {
           'cflags!': [ '-O3' ],
           'cflags': [ '-g', '-O0' ],
-- 
