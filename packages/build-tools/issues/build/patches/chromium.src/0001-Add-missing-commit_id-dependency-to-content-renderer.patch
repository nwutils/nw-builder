From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ayushman Chhabra <14110965+ayushmanchhabra@users.noreply.github.com>
Date: Sat, 21 Nov 2026 06:57:04 +0000
Subject: [PATCH] Add missing commit_id dependency to content/renderer

renderer_blink_platform_impl.cc includes nw/id/commit.h, generated by
//content/nw:commit_id, without depending on it, so the build can fail
with "'nw/id/commit.h' file not found".
---
 content/renderer/BUILD.gn | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/content/renderer/BUILD.gn b/content/renderer/BUILD.gn
index 6c2bff46..d189af08 100644
--- a/content/renderer/BUILD.gn
+++ b/content/renderer/BUILD.gn
@@ -257,6 +257,10 @@ target(link_target_type, "renderer") {
     "//content/common:main_frame_counter",
     "//content/common/memory_coordinator/mojom",
     "//content/gpu:gpu_sources",
+
+    # NW.js: renderer_blink_platform_impl.cc includes nw/id/commit.h, which
+    # this target generates.
+    "//content/nw:commit_id",
     "//content/public/child:child_sources",
     "//content/public/common:buildflags",
     "//crypto",
-- 
2.43.0

