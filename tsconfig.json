{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node", "nw.js", "chrome"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}
